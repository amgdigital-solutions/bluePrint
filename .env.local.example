# ============================================
# Blueprints Club - Environment Variables
# ============================================

# Database (Neon PostgreSQL)
# Get this from your Neon dashboard → Connection Details
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/blueprintsclub?sslmode=require

# NextAuth.js (for authentication)
# Generate a random secret: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_secret_here
NEXTAUTH_URL=http://localhost:3000

# Square Payments (Sandbox for testing)
# Get from developer.squareup.com → Applications
SQUARE_APPLICATION_ID=sandbox-xxx
SQUARE_ACCESS_TOKEN=sandbox-xxx
SQUARE_ENVIRONMENT=sandbox

# Google Maps (optional - for real geocoding)
GOOGLE_MAPS_API_KEY=your_key_here
